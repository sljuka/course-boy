// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.matko.app",
  // Off on purpose (CLAUDE.md): the Bare worker is a separate process that can't
  // read inside an asar archive, and the OS can't run the `bare` binary from one.
  "asar": false,
  "productName": "Matko",
  // Electron's fuses (SLJ-152): switches in the Electron program itself, set
  // here when packaging, that nothing can turn back on at run time. Off: running
  // the app as plain Node (ELECTRON_RUN_AS_NODE), loading a script through
  // NODE_OPTIONS, and the --inspect debugger: with any of them, a program on the
  // computer (or a crafted launch argument, SLJ-151) could run its own code as
  // Matko. Matko uses none of them: the P2P worker runs in Bare, not Electron
  // as Node. Development (`npm run dev`) is unaffected. The asar fuses stay off
  // with asar. `npm run check:packaged` checks they hold.
  "electronFuses": {
    "runAsNode": false,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableNodeCliInspectArguments": false,
    // Flipping a fuse changes the program, which voids the ad-hoc signature
    // Electron ships with on macOS; Apple Silicon won't start it unsigned.
    "resetAdHocDarwinSignature": true
  },
  // `matko://` links (SLJ-8, SLJ-60) open the app: the macOS Info.plist, the
  // Windows installer's registry entries, and the Linux packages' desktop
  // entry. The app also registers at startup (electron/app-link-intake.ts),
  // which is what makes it work for the AppImage.
  "protocols": [
    {
      "name": "Matko link",
      "schemes": [
        "matko"
      ]
    }
  ],
  "directories": {
    "output": "release/${version}"
  },
  // Everything the app reads from its own folder at runtime (APP_ROOT): the
  // Bare worker, the bundled seed course, the SVG presets. Production
  // `dependencies` are added automatically. `npm run check:packaged` verifies it.
  "files": [
    "dist",
    "dist-electron",
    "workers",
    "!workers/**/*.test.*",
    "courses",
    "presets"
  ],
  "mac": {
    "target": [
      "dmg"
    ],
    // One DMG per architecture (built on separate runners, see
    // .github/workflows/release.yml), so the name must say which.
    "artifactName": "${productName}-Mac-${version}-${arch}-Installer.${ext}"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}-Windows-${version}-Setup.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  // The AppImage runs anywhere without installing; the deb (Ubuntu, Debian)
  // and rpm (Fedora) install normally and register `matko://` links on
  // install. Building the rpm needs `rpmbuild` (the `rpm` package on the
  // Linux runner, see .github/workflows/release.yml).
  "linux": {
    "target": [
      "AppImage",
      "deb",
      "rpm"
    ],
    "artifactName": "${productName}-Linux-${version}.${ext}",
    "category": "Education",
    "maintainer": "Matko maintainers",
    "synopsis": "Make, take and share courses",
    "description": "Matko is an app for making, taking and sharing courses, peer to peer."
  }
}
